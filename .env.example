# 将下面两个占位符替换为你自己的 API Key，然后把本文件复制为 .env。
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY_HERE

# 可选：联网核验优先使用 Tavily；不填则自动回退 DuckDuckGo。
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=15

# DeepSeek 官方 OpenAI 兼容接口。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.4

# 智谱文本向量模型。
ZHIPU_EMBEDDING_MODEL=embedding-3

# 数据与索引路径。相对路径均以项目根目录为基准。
EXCEL_PATH=江西-2025高报数据参考-家长版.xlsx
INDEX_DIR=data/index
EXCEL_SHEET=Sheet1
EXCEL_HEADER_ROW=2

# 混合检索参数；两项权重之和应为 1。
BM25_WEIGHT=0.45
VECTOR_WEIGHT=0.55
TOP_K=8
RETRIEVAL_CANDIDATES=40
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_BATCH_CHARS=12000
EMBEDDING_MAX_TEXT_CHARS=6000
